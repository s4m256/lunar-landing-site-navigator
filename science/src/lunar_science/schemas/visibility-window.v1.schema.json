{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lunar.local/contracts/visibility-window.v1.schema.json",
  "title": "visibility-window 1.0.0 — MVP B hourly fallback",
  "description": "Apparent center directions on 721 inclusive UTC samples over 720 hours. Topography is unavailable, never synthetic or assumed zero. Existing analysis request keeps its own exclusive end one step after last sample.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start_utc": {
          "const": "2026-11-15T00:00:00Z"
        },
        "end_utc": {
          "const": "2026-12-15T00:00:00Z"
        },
        "end_inclusive": {
          "const": true
        },
        "step_seconds": {
          "const": 3600
        },
        "timestamp_count": {
          "const": 721
        },
        "interval_count": {
          "const": 720
        }
      },
      "required": [
        "start_utc",
        "end_utc",
        "end_inclusive",
        "step_seconds",
        "timestamp_count",
        "interval_count"
      ]
    },
    "analysis": {
      "$ref": "#/definitions/analysis"
    },
    "topography": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "unavailable"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "status",
        "reason"
      ]
    },
    "visibility": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "site_id": {
            "enum": [
              "south-a",
              "south-b"
            ]
          },
          "target": {
            "enum": [
              "SUN",
              "EARTH"
            ]
          },
          "ideal_visible": {
            "type": "array",
            "minItems": 721,
            "maxItems": 721,
            "items": {
              "type": "boolean"
            }
          },
          "topographic_visible": {
            "type": "null"
          }
        },
        "required": [
          "site_id",
          "target",
          "ideal_visible",
          "topographic_visible"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "window",
    "analysis",
    "topography",
    "visibility"
  ],
  "definitions": {
    "analysis": {
      "title": "analysis-result 1.0.0",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "request": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema_version": {
              "const": "1.0.0"
            },
            "frame": {
              "const": "IAU_MOON"
            },
            "surface_radius_m": {
              "const": 1737400
            },
            "sites": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "latitude_deg": {
                    "type": "number",
                    "minimum": -90,
                    "maximum": 90
                  },
                  "longitude_east_deg": {
                    "type": "number",
                    "minimum": 0,
                    "exclusiveMaximum": 360
                  },
                  "height_m": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 10000
                  }
                },
                "required": [
                  "id",
                  "latitude_deg",
                  "longitude_east_deg",
                  "height_m"
                ]
              }
            },
            "start_utc": {
              "type": "string",
              "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{1,3})?Z$"
            },
            "end_utc": {
              "type": "string",
              "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{1,3})?Z$"
            },
            "step_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400
            }
          },
          "required": [
            "schema_version",
            "frame",
            "surface_radius_m",
            "sites",
            "start_utc",
            "end_utc",
            "step_seconds"
          ]
        },
        "series": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "site_id": {
                "type": "string",
                "minLength": 1
              },
              "target": {
                "enum": [
                  "SUN",
                  "EARTH"
                ]
              },
              "samples": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "utc": {
                      "type": "string",
                      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{1,3})?Z$"
                    },
                    "azimuth_deg": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 360
                    },
                    "elevation_deg": {
                      "type": "number",
                      "minimum": -90,
                      "maximum": 90
                    }
                  },
                  "required": [
                    "utc",
                    "azimuth_deg",
                    "elevation_deg"
                  ]
                }
              }
            },
            "required": [
              "site_id",
              "target",
              "samples"
            ]
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema_version": {
              "const": "1.0.0"
            },
            "engine_version": {
              "type": "string",
              "minLength": 1
            },
            "spiceypy_version": {
              "type": "string",
              "minLength": 1
            },
            "numpy_version": {
              "type": "string",
              "minLength": 1
            },
            "cspice_version": {
              "type": "string",
              "minLength": 1
            },
            "frame": {
              "const": "IAU_MOON"
            },
            "correction": {
              "const": "CN+S"
            },
            "frame_epoch": {
              "const": "OBSERVER"
            },
            "time_scale": {
              "const": "UTC input/output; TDB seconds past J2000 internally"
            },
            "surface_radius_m": {
              "const": 1737400
            },
            "horizon_elevation_deg": {
              "const": 0
            },
            "azimuth_convention": {
              "type": "string",
              "minLength": 1
            },
            "kernels": {
              "type": "array",
              "minItems": 3,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "filename": {
                    "type": "string",
                    "minLength": 1
                  },
                  "url": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "type": {
                    "type": "string",
                    "minLength": 1
                  },
                  "coverage_et": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "array",
                      "items": {
                        "type": "array",
                        "items": {
                          "type": "number"
                        },
                        "minItems": 2,
                        "maxItems": 2
                      }
                    }
                  }
                },
                "required": [
                  "filename",
                  "url",
                  "sha256",
                  "type",
                  "coverage_et"
                ]
              }
            },
            "limitations": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "horizons_validation": {
              "const": "not_performed_in_engine"
            }
          },
          "required": [
            "schema_version",
            "engine_version",
            "spiceypy_version",
            "numpy_version",
            "cspice_version",
            "frame",
            "correction",
            "frame_epoch",
            "time_scale",
            "surface_radius_m",
            "horizon_elevation_deg",
            "azimuth_convention",
            "kernels",
            "limitations",
            "horizons_validation"
          ]
        }
      },
      "required": [
        "schema_version",
        "request",
        "series",
        "provenance"
      ]
    }
  }
}
